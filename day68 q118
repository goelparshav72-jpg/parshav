#include <stdio.h>

int main()
{
    int n;
    int nums[100];
    int missing = -1;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for(int i = 0; i < n; i++)
    {
        scanf("%d", &nums[i]);
    }

    // Check every number from 0 to n
    for(int i = 0; i <= n; i++)
    {
        int found = 0;

        for(int j = 0; j < n; j++)
        {
            if(nums[j] == i)
            {
                found = 1;
                break;
            }
        }

        if(found == 0)
        {
            missing = i;
            break;
        }
    }

    printf("%d", missing);

    return 0;
}
