#include <stdio.h>

int main()
{
    int m, n;
    int nums1[100], nums2[100], merged[200];
    int i = 0, j = 0, k = 0;

    printf("Enter size of first array: ");
    scanf("%d", &m);

    printf("Enter first sorted array:\n");
    for(int x = 0; x < m; x++)
    {
        scanf("%d", &nums1[x]);
    }

    printf("Enter size of second array: ");
    scanf("%d", &n);

    printf("Enter second sorted array:\n");
    for(int x = 0; x < n; x++)
    {
        scanf("%d", &nums2[x]);
    }

    // Merge both arrays
    while(i < m && j < n)
    {
        if(nums1[i] <= nums2[j])
        {
            merged[k] = nums1[i];
            i++;
        }
        else
        {
            merged[k] = nums2[j];
            j++;
        }

        k++;
    }

    // Copy remaining elements of first array
    while(i < m)
    {
        merged[k] = nums1[i];
        i++;
        k++;
    }

    // Copy remaining elements of second array
    while(j < n)
    {
        merged[k] = nums2[j];
        j++;
        k++;
    }

    // Print merged array
    for(int x = 0; x < m + n; x++)
    {
        printf("%d", merged[x]);

        if(x != m + n - 1)
        {
            printf(" ");
        }
    }

    return 0;
}
