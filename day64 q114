
#include <stdio.h>

int main()
{
    char s[100];
    int max = 0, count, repeat;

    printf("Enter a string: ");
    scanf("%99s", s);

    for(int i = 0; s[i] != '\0'; i++)
    {
        count = 0;

        for(int j = i; s[j] != '\0'; j++)
        {
            repeat = 0;

            for(int k = i; k < j; k++)
            {
                if(s[j] == s[k])
                {
                    repeat = 1;
                    break;
                }
            }

            if(repeat == 1)
            {
                break;
            }

            count++;
        }

        if(count > max)
        {
            max = count;
        }
    }

    printf("%d", max);

    return 0;
}
