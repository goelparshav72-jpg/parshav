#include <stdio.h>

int main()
{
    FILE *fp;
    char line[100];

    // Open file in read mode
    fp = fopen("info.txt", "r");

    // Check if file exists
    if(fp == NULL)
    {
        printf("File not found!");
        return 1;
    }

    // Read file line by line
    while(fgets(line, 100, fp) != NULL)
    {
        printf("%s", line);
    }

    // Close the file
    fclose(fp);

    return 0;
}
