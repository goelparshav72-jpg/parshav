#include <stdio.h>

int main()
{
    int n, target;
    int nums[100];
    int first = -1, second = -1;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for(int i = 0; i < n; i++)
    {
        scanf("%d", &nums[i]);
    }

    printf("Enter target: ");
    scanf("%d", &target);

    for(int i = 0; i < n; i++)
    {
        for(int j = i + 1; j < n; j++)
        {
            if(nums[i] + nums[j] == target)
            {
                first = i;
                second = j;
                break;
            }
        }

        if(first != -1)
        {
            break;
        }
    }

    printf("%d %d", first, second);

    return 0;
}
