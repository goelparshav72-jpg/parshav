#include <stdio.h>

int main()
{
    int n;
    int nums[100];
    int count[101] = {0};
    int repeated = -1;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");

    for(int i = 0; i < n; i++)
    {
        scanf("%d", &nums[i]);
    }

    // Single iteration
    for(int i = 0; i < n; i++)
    {
        if(count[nums[i]] == 1)
        {
            repeated = nums[i];
            break;
        }

        count[nums[i]]++;
    }

    printf("%d", repeated);

    return 0;
}
