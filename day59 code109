#include <stdio.h>

int main()
{
    int n, k;
    int arr[100];

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (int i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter value of k: ");
    scanf("%d", &k);

    int maxSum = -999999;

    for (int i = 0; i <= n - k; i++)
    {
        int sum = 0;

        for (int j = i; j < i + k; j++)
        {
            sum = sum + arr[j];
        }

        if (sum > maxSum)
        {
            maxSum = sum;
        }
    }

    printf("%d", maxSum);

    return 0;
}
