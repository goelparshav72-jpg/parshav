#include <stdio.h>

int main()
{
    FILE *fp;
    char text[200];

    // Open file in append mode
    fp = fopen("data.txt", "a");

    if(fp == NULL)
    {
        printf("Unable to open file!");
        return 1;
    }

    printf("Enter text to append: ");
    scanf(" %[^\n]", text);

    // Append text to the file
    fprintf(fp, "\n%s", text);

    // Close the file
    fclose(fp);

    printf("File updated successfully with appended text.");

    return 0;
}
