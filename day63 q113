
#include <stdio.h>

int main()
{
    int n, k, temp;
    int arr[100];

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for(int i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter value of k: ");
    scanf("%d", &k);

    // Sort array in ascending order
    for(int i = 0; i < n - 1; i++)
    {
        for(int j = 0; j < n - i - 1; j++)
        {
            if(arr[j] > arr[j + 1])
            {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    if(k >= 1 && k <= n)
    {
        printf("%d", arr[k - 1]);
    }
    else
    {
        printf("Invalid k");
    }

    return 0;
}
